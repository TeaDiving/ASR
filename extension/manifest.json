{
  "manifest_version": 3,
  "name": "AI Simultaneous Interpretation Assistant",
  "version": "0.1.0",
  "description": "Injects a subtitle overlay for webpage video interpretation and lets users configure translation API credentials.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Interpreter"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
